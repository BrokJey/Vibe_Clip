<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Основная тема (после загрузки) -->
    <style name="Theme.VibeClip_Frontend" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Splash при старте MainActivity -->
    <style name="Theme.VibeClip.Splash" parent="Theme.VibeClip_Frontend">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
